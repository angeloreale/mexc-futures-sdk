{
  "name": "mexc-futures-sdk",
  "version": "1.6.2",
  "description": "Dupip Crypto Connector — MEXC Futures Telegram Signal Bot. Automates futures trading by listening for trade signals on Telegram channels and executing them on MEXC.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.desktop.json",
    "dev": "tsc -w",
    "test": "jest",
    "example": "ts-node examples/basic.ts",
    "bot": "ts-node src/bot/index.ts",
    "bot:start": "node dist/bot/index.js",
    "desktop:dev": "npm run build && electron dist-desktop/main.js",
    "desktop:build": "npm run build && electron-builder --config electron-builder.yml",
    "desktop:build:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "desktop:build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "desktop:build:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "desktop:build:all": "npm run build && electron-builder --mac --win --linux --config electron-builder.yml",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "mexc",
    "futures",
    "trading",
    "sdk",
    "crypto",
    "cryptocurrency",
    "typescript",
    "api",
    "websocket",
    "trading-bot",
    "automation",
    "mexc-api",
    "maintenance-bypass"
  ],
  "author": "oboshto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oboshto/mexc-futures-sdk.git"
  },
  "homepage": "https://github.com/oboshto/mexc-futures-sdk#readme",
  "bugs": {
    "url": "https://github.com/oboshto/mexc-futures-sdk/issues"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "axios": "^1.17.0",
    "json-bigint": "^1.0.0",
    "md5": "^2.3.0",
    "telegraf": "^4.16.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.0.0",
    "@types/json-bigint": "^1.0.4",
    "@types/md5": "^2.3.5",
    "@types/node": "^20.0.0",
    "dotenv": "^16.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.dupip.cryptoconnector",
    "productName": "Dupip Crypto Connector",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "desktop/renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": ["dmg", "zip"],
      "icon": "desktop/renderer/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "desktop/renderer/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Finance",
      "icon": "desktop/renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
