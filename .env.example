# ──────────────────────────────────────────────
# MEXC Telegram Signal Bot — Environment Config
# Copy to .env and fill in your values.
# ⚠️  NEVER commit .env to version control!
# ──────────────────────────────────────────────

# ── MEXC Credentials ──────────────────────────
# Method 1: API Key + Secret (recommended for bots)
# Generate these at MEXC → API Management → Create API Key
MEXC_KEY=
MEXC_SECRET_KEY=

# Method 2: Browser WEB token (legacy — get from browser DevTools, starts with "WEB...")
# Leave blank if using Method 1 above
# MEXC_AUTH_TOKEN=

# ── Telegram ──────────────────────────────────
# Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of allowed channel/chat IDs (numeric) or @usernames
# Example: -1001234567890,@signals_channel
ALLOWED_CHANNELS=

# ── Trading Settings ──────────────────────────
# Default leverage (1-200)
DEFAULT_LEVERAGE=10

# Margin mode: 1 = isolated (default), 2 = cross
OPEN_TYPE=1

# ── Risk Management ──────────────────────────
# Risk per trade as decimal (0.01 = 1% of equity)
RISK_PERCENT=0.01

# Default TP:SL ratio when signal has no TP (1.5 = 1.5R)
DEFAULT_TP_RATIO=1.5

# Maximum number of concurrent open positions
MAX_CONCURRENT_TRADES=5

# Maximum notional value per trade in USDT
MAX_NOTIONAL_PER_TRADE=10000

# ── Operational ───────────────────────────────
# Dry run mode (true = parse/size but don't submit orders)
DRY_RUN=true

# Master trading switch (false = disable all order submission)
TRADING_ENABLED=true

# Log level: SILENT, ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# Base currency for equity (default: USDT)
BASE_CURRENCY=USDT

# Path to state file for idempotency tracking
STATE_FILE_PATH=./bot-state.json

# Directory for persistent log files (signals-*.log, trades-*.log, bot-*.log)
# Rotates daily — files older than LOG_RETENTION_DAYS are auto-deleted
LOG_DIR=./logs

# Number of days to retain log files before auto-deleting (default: 90)
LOG_RETENTION_DAYS=90

# ── Position-Close Notifications ─────────────
# Telegram channel/chat ID (numeric or @username) that receives a message
# whenever a position closes, showing realized PNL (+ %), available balance
# and equity after the close. Leave empty to disable.
# Example: -1001234567890 or @pnl_channel
PNL_NOTIFICATION_CHANNEL=

# How often (seconds) to poll MEXC for closed positions (min 5, default 30)
POSITION_MONITOR_INTERVAL_SECONDS=30
